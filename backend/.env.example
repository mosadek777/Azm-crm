# Copy to .env and fill in. .env is gitignored and must never be committed.

# Mongo — a single-node replica set is required: transactions are not optional,
# because utils/audit.js writes the audit entry and the mutation atomically
# (spec 010 E-11). ?replicaSet=rs0 makes a misconfigured set fail loudly at
# connect rather than at the first transaction.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
PORT=3000

# Local sign-in. Spec 010 FR-006 also requires SSO via SAML or OIDC, which is
# an uncovered MUST — see docs/trace.md.
JWT_SECRET=generate-with-openssl-rand-hex-48
JWT_EXPIRES_IN=8h
SALT_ROUNDS=12

# Turns a local phone form into E.164 (spec 001 FR-002, AS-02). An inference
# from the specs' worked examples, not a stated requirement — decision 19.
DEFAULT_COUNTRY_CODE=+20

# Break-glass administrator, seeded once by `npm run seed:admin`.
# Spec 010 E-07: its sign-in is a high-severity audit event. Change the password
# before any real use.
BREAKGLASS_EMAIL=admin@example.com
BREAKGLASS_PASSWORD=change-me-before-first-use

# Optional — only for tools/sync-clickup.js. Not required to run the app.
CLICKUP_TOKEN=
